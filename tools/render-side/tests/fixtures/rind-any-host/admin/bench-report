#!/usr/bin/env python3
"""admin/bench-report after the CPU-slug change: no HOSTS attribute.

report() draws every host it is given, in dict order, and reads host["note"].
"""

REPORT = "BENCHMARKS.md"
REPORT_DIR = "benchmarks"

COLUMNS = {
    "rind": "rind",
    "ring": "ring",
}

LABELS = {
    "x25519-ecdh": "X25519 ECDH",
}

GENERATED = (
    "<!-- Generated by `admin/bench-report render` from benchmarks/data, "
    "benchmarks/verified.toml, and benchmarks/gaps.toml. -->"
)
PINNED = (
    "Each host builds with the pinned toolchain in the Nix dev shell, and runs "
    "`admin/bench-report` only when idle. Times are criterion's estimates."
)


def load_verified():
    return {}


def label(row):
    return LABELS[row]


def gaps_of(hosts, tiers):
    out = {}
    if "intel-core-ultra-9-275hx" in hosts:
        out[("x25519-ecdh", "intel-core-ultra-9-275hx")] = (1.5, "ring")
    return out


def report(hosts, tiers, verified, gaps):
    shown = ", ".join(f"`{name}`" for name in hosts)
    notes = []
    for name, host in hosts.items():
        note = host.get("note")
        if note:
            notes.append(f"{name}: {note}")
    md = "\n".join(
        [
            "# Benchmarks",
            "",
            GENERATED,
            "",
            f"Side sheet for {shown}.",
            "",
            PINNED,
            "",
            *notes,
            "",
            "## CPU tiers",
            "",
            "This section is replaced by render-side.",
            "",
            "## Verified code",
            "",
            "Proofs are unchanged in this stub.",
            "",
        ]
    )
    svg = (
        "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"8\" height=\"8\">"
        "<rect width=\"8\" height=\"8\" fill=\"#036\"/></svg>\n"
    )
    return {REPORT: md, f"{REPORT_DIR}/overview.svg": svg}
