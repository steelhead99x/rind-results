+#!/usr/bin/env bash
+# bench-only: appends rind::__board_bench::poly1305 (via low::board_poly1305) (not for any PR)
+set -euo pipefail
+cat >> "$1/rind/src/low/mod.rs" <<'RS'
+
+/// Board-local bench shim (never committed to a PR).
+#[cfg(rind_backend = "portable")]
+pub(crate) fn board_poly1305(key: &[u8; 32], msg: &[u8]) -> [u8; 16] {
+    let mut p = portable::poly1305::Poly1305::new(key);
+    p.add_bytes(msg);
+    p.finish()
+}
+RS
+cat >> "$1/rind/src/lib.rs" <<'RS'
+
+/// Board-local bench shim (never committed to a PR).
+#[doc(hidden)]
+#[allow(missing_docs, unreachable_pub)]
+pub mod __board_bench {
+    pub fn poly1305(key: &[u8; 32], msg: &[u8]) -> [u8; 16] {
+        crate::low::board_poly1305(key, msg)
+    }
+}
+RS
