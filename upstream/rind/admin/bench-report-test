def host(name, arch, os_name, cpuid, results):
    return {
        "schema": 1,
        "host": name,
        "commit": "0123456789abcdef0123456789abcdef01234567",
        "started": "2026-11-03T02:00:00+00:00",
        "status": "ok",
        "cpu": {"model": f"{name} CPU", "arch": arch, "logical_cpus": 8},
        "os": os_name,
        "toolchain": {"rustc": "rustc 1.98.1"},
        "rind_cpu": {"cpuid": cpuid},
        "load": {"noisy": False},
        "results": [{"operation": op, "library": lib, "ns": ns} for op, lib, ns in results],
    }


